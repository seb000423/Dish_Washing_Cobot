<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ui_ros</name>
  <version>0.1.0</version>
  <description>ROS2 support nodes and separately executed Flask HMI for the dishwasher robot.</description>

  <maintainer email="seb000423@gmail.com">seb000423</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>dsr_msgs2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-pymodbus</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
